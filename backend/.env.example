APP_ENV=development
DATABASE_URL=postgresql+asyncpg://replace_me:replace_me@localhost:5432/dm_karo
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
JWT_SECRET_KEY=
JWT_ISSUER=dm-karo-api
JWT_AUDIENCE=dm-karo-web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_HOURS=24
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_DOMAIN=
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT=10
AUTH_SENSITIVE_RATE_LIMIT=5
PUBLIC_APP_URL=http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=false
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v27.0
META_FACEBOOK_LOGIN_CONFIG_ID=
META_TOKEN_ENCRYPTION_KEY=
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
AUTOMATION_WORKER_MAX_ATTEMPTS=5
AUTOMATION_WORKER_BLOCK_MS=5000

# AI provider credentials are server-side only; never put these in VITE_* variables.
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_OPENAI_MODEL=gpt-6-astra
AI_GEMINI_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_REQUESTS_PER_MINUTE=20
AI_DAILY_REQUEST_LIMIT=100
AI_MAX_INPUT_CHARACTERS=12000
AI_MAX_OUTPUT_TOKENS=1000
# Optional USD per million tokens. Leave blank unless set from current official pricing.
AI_OPENAI_INPUT_COST_PER_MILLION=
AI_OPENAI_OUTPUT_COST_PER_MILLION=
AI_GEMINI_INPUT_COST_PER_MILLION=
AI_GEMINI_OUTPUT_COST_PER_MILLION=

# Razorpay credentials must be Test Mode keys and remain server-side only.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_GRACE_PERIOD_DAYS=7

POSTGRES_DB=dm_karo
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432
REDIS_PORT=6379
